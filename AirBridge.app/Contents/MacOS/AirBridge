#!/usr/bin/env bash

# Resolve project location dynamically
APP_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/../../.." >/dev/null 2>&1 && pwd )"

if [ -f "$APP_DIR/server/index.js" ]; then
    cd "$APP_DIR"
elif [ -f "./server/index.js" ]; then
    cd "."
fi

# Ensure node is in PATH for GUI launch
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.nvm/versions/node/$(ls $HOME/.nvm/versions/node 2>/dev/null | tail -n 1)/bin:$PATH"

NODE_BIN=$(command -v node || echo "/opt/homebrew/bin/node")

if [ ! -x "$NODE_BIN" ]; then
    osascript -e 'display alert "Node.js Not Found" message "Please install Node.js from https://nodejs.org to run AirBridge."'
    exit 1
fi

# Check if server is already running
if ! curl -s http://localhost:5050/api/info > /dev/null 2>&1; then
    # Start server in background
    AUTO_OPEN=false "$NODE_BIN" server/index.js > /tmp/airbridge.log 2>&1 &
    
    # Wait up to 5s for server to start
    for i in {1..20}; do
        if curl -s http://localhost:5050/api/info > /dev/null 2>&1; then
            break
        fi
        sleep 0.25
    done
fi

URL="http://localhost:5050"

# Open as a dedicated standalone App Window (frameless/no URL bar) if Chrome/Brave/Edge is present
if [ -d "/Applications/Google Chrome.app" ]; then
    open -na "/Applications/Google Chrome.app" --args --app="$URL" --window-size=1150,820
elif [ -d "/Applications/Brave Browser.app" ]; then
    open -na "/Applications/Brave Browser.app" --args --app="$URL" --window-size=1150,820
elif [ -d "/Applications/Microsoft Edge.app" ]; then
    open -na "/Applications/Microsoft Edge.app" --args --app="$URL" --window-size=1150,820
else
    # Default browser
    open "$URL"
fi
